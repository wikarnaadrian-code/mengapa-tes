{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(admin|klien|tim|hkgold|HKGold|HKGOLD|HkGold)(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(pandangan-kerja|pandangan-kerja-hasil)(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:hk(HKGold|hkgold|HKGOLD|HkGold)/:rest*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:slug((?!(?:admin|api|assets|klien|tim|hkgold|layanan|index|pandangan-kerja|pandangan-kerja-hasil|logo-klien|apps-script|robots|sitemap|favicon|README)$)[A-Za-z0-9][A-Za-z0-9-]{1,38}[A-Za-z0-9])",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/our_story(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/our_services(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/our_team(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/counseling(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/workshops(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tests_catalogue(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/select_language(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/public-workshops(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/private-workshops(.html)?",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:hk(HKGold|hkgold|HKGOLD|HkGold)/:t(TesPandanganKerja|tespandangankerja|TESPANDANGANKERJA|Tespandangankerja)/:h(Hasil|hasil|HASIL)",
      "destination": "/pandangan-kerja-hasil"
    },
    {
      "source": "/:hk(HKGold|hkgold|HKGOLD|HkGold)/:t(TesPandanganKerja|tespandangankerja|TESPANDANGANKERJA|Tespandangankerja)",
      "destination": "/pandangan-kerja"
    },
    {
      "source": "/HKGold",
      "destination": "/hkgold"
    },
    {
      "source": "/HKGOLD",
      "destination": "/hkgold"
    },
    {
      "source": "/HkGold",
      "destination": "/hkgold"
    },
    {
      "source": "/:t(quicktest|fulltest|mindsettest|QuickTest|FullTest|MindsetTest|Quicktest|Fulltest|Mindsettest|teslengkap|tesmini|tesmindset|TesLengkap|TesMini|TesMindset|Teslengkap|Tesmini|Tesmindset)",
      "destination": "/"
    },
    {
      "source": "/layanan",
      "destination": "/"
    },
    {
      "source": "/:slug((?!(?:admin|api|assets|klien|tim|hkgold|layanan|teslengkap|tesmini|tesmindset|quicktest|fulltest|mindsettest|index|pandangan-kerja|pandangan-kerja-hasil|logo-klien|apps-script|robots|sitemap|favicon|README)$)[A-Za-z0-9][A-Za-z0-9-]{1,38}[A-Za-z0-9])",
      "destination": "/api/klienpage?slug=:slug"
    }
  ],
  "functions": {
    "api/klienpage.js": {
      "includeFiles": "klien.html"
    }
  }
}
